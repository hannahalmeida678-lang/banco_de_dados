SELECT nome, autor, preco
FROM livros;

SELECT DISTINCT genero
FROM livros
ORDER BY genero ASC;

SELECT COUNT(DISTINCT autor) AS quantidade_autores
FROM livros;

SELECT nome, preco
FROM livros
ORDER BY preco DESC
LIMIT 5;

SELECT nome, ano_publicacao, genero
FROM livros
WHERE ano_publicacao BETWEEN 2010 AND 2020
